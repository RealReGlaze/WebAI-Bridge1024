{
  "// 说明": "仅存配置，不含账号密码/Cookie/令牌。登录态由 Edge 专用 profile（.runtime/ 目录）承载。",
  "defaults": {
    "waitForResponse": {
      "totalTimeoutMs": 600000,
      "stablePolls": 3,
      "pollIntervalMs": 800
    }
  },
  "backends": [
    {
      "id": "deepseek",
      "displayName": "DeepSeek 网页版",
      "startUrl": "https://chat.deepseek.com/",
      "adapterType": "deepseek-web",
      "browser": {
        "debugPort": 9223,
        "profileDir": ".runtime/edge-profile-deepseek"
      },
      "enabled": true,
      "capabilities": {
        "multiTurnConversation": true,
        "attachments": true,
        "streaming": true
      },
      "notes": "选择器于 2026-10-18 实测校准（登录后：input 无 id、name=search）"
    },
    {
      "id": "mimo",
      "displayName": "小米 MiMo 网页版",
      "startUrl": "https://aistudio.xiaomimimo.com/#/c",
      "adapterType": "mimo-web",
      "browser": {
        "debugPort": 9225,
        "profileDir": ".runtime/edge-profile-mimo"
      },
      "enabled": true,
      "capabilities": {
        "multiTurnConversation": true,
        "attachments": null,
        "streaming": true
      },
      "notes": "2026-10-18 校准（未登录态）：输入框=textarea（占位符「登录后可继续聊天」），登录指示=未登录/立即登录。首次使用需在专用 Edge 窗口手动登录小米账号。"
    },
    {
      "id": "qianwen",
      "displayName": "千问网页版",
      "startUrl": "https://www.qianwen.com/",
      "adapterType": "qianwen-web",
      "browser": {
        "debugPort": 9224,
        "profileDir": ".runtime/edge-profile-qianwen"
      },
      "enabled": false,
      "notes": "暂未启用"
    }
  ]
}
